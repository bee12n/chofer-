# Base de datos Postgres (Vercel la llena sola al conectar Neon)
DATABASE_URL=postgres://usuario:password@host/db?sslmode=require

# Frase larga y secreta para firmar las sesiones (mínimo 32 caracteres)
SESSION_SECRET=

# Contraseñas de administración (el perfil de chofer no lleva contraseña)
PASS_XIMENA=
PASS_ANA=
